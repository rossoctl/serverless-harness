node_modules/
dist/
*.log
.pi/

# Raw per-run experiment output - EXPERIMENTS.md carries the numbers that
# matter; the underlying per-VM JSON/log files are throwaway rig artifacts,
# not evidence to keep in git.
deploy/microvm/e12-results/

# Secrets and credentials
.env
.env.*
.env.local
*.key
*.pem
*.p12
credentials.*
# core.ignorecase (default on macOS/APFS) makes the pattern above match this legitimate
# component source file too, since it has no secret material — the credential model is
# write-only end to end. See src/views/overlays/Sessions.tsx, NewSession.tsx, Login.tsx for
# the sibling naming convention this file follows.
!packages/mocactl/src/views/overlays/Credentials.tsx
secrets.*
*kubeconfig*

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Implementation plans are local-only, ephemeral work artifacts (see docs/plans/README.md).
# They go stale the moment code merges; the durable "why" lives in docs/specs/ + docs/adrs/.
docs/plans/*
!docs/plans/README.md

# E2 writes each run's measured table here; experiments/RESULTS.md is the committed
# baseline and is no longer overwritten by a test run (see experiments/README.md).
experiments/.results/

# Workspace-only checksums. Redundant with each module go.sum, and the checksum
# database still verifies downloads without it -- one less sum file to keep in sync.
go.work.sum

# E13 rig diagnostics (deploy/microvm/e13-*.sh) - throwaway rig output, not
# source, per PR #272's own late fix removing the equivalent e12-results/.
deploy/microvm/e13-results/
deploy/microvm/e13-control-results/
deploy/microvm/e13-telemetry/

# Python bytecode cache - deploy/microvm/tests/e13-correlate.test.sh imports
# e13-correlate.py, and every run regenerates this.
__pycache__/
